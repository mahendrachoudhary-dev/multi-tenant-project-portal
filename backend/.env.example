NODE_ENV=development
PORT=5000
# Use your MongoDB Atlas connection string (replica set required for transactions).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/multi_tenant_project?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173
SESSION_DAYS=7
TRUST_PROXY=0
SERVE_FRONTEND=false
# Choose a dedicated demo password with at least 12 characters before running npm run seed.
DEMO_PASSWORD=
