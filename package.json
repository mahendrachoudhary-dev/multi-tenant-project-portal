{
  "name": "multi-tenant-project",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "seed": "npm run seed -w backend",
    "test": "npm test -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
